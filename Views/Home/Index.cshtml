@{
    ViewData["Title"] = "Inicio";

    // La misma portada sirve con y sin sesión. Sin cuenta no se muestra la navegación
    // de la app —todas sus secciones piden login— sino una barra con la marca y el acceso.
    var conSesion = User.Identity is { IsAuthenticated: true };
    if (!conSesion) { Layout = "_LayoutLimpio"; }
}

@if (!conSesion)
{
    <div class="fc-barra-limpia">
        <a asp-controller="Home" asp-action="Index" class="fc-brand fc-brand-text">FitnessCoach</a>
        <div class="d-flex gap-2">
            <a asp-controller="Account" asp-action="Login" class="btn fc-btn-outline px-3 py-2">Entrar</a>
            <a asp-controller="Account" asp-action="Register" class="btn fc-btn-primary px-3 py-2">Crear cuenta</a>
        </div>
    </div>
}

@* ===== HERO ===== *@
<div class="fc-hero-section">
    <div class="row align-items-center g-0" style="min-height:80vh;">
        <div class="col-md-6 px-4 px-md-5">
            <div class="fc-tag mb-4">Coach Fit Inteligente</div>
            <h1 class="fc-hero-title">Alcanza tu<br /><span style="color:var(--fc-primary-texto);">máximo potencial</span></h1>
            <p class="fc-hero-sub mt-3 mb-4">
                Tu rutina, tu plan de comidas y <strong style="color:var(--fc-text);">Koda</strong>,
                un coach que ve tus números reales. Gratis.
            </p>
            <div class="d-flex gap-3 flex-wrap mb-4">
                @if (conSesion)
                {
                    <a asp-controller="Perfil" asp-action="Index" class="btn fc-btn-primary px-4 py-2">
                        <i class="fas fa-user-cog me-2" aria-hidden="true"></i>Configurar Perfil
                    </a>
                    <a asp-controller="Rutinas" asp-action="Index" class="btn fc-btn-outline px-4 py-2">
                        <i class="fas fa-list-check me-2" aria-hidden="true"></i>Ver mi Rutina
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Register" class="btn fc-btn-primary px-4 py-2">
                        <i class="fas fa-bolt me-2" aria-hidden="true"></i>Crear mi cuenta
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn fc-btn-outline px-4 py-2">
                        <i class="fas fa-right-to-bracket me-2" aria-hidden="true"></i>Ya tengo cuenta
                    </a>
                }
            </div>
            @* Los atributos de Koda (del character sheet) como chips pixel *@
            <div class="d-flex flex-wrap gap-2">
                <span class="fc-chip"><i class="fas fa-bullseye me-1" style="color:var(--fc-primary-texto);" aria-hidden="true"></i>Disciplina</span>
                <span class="fc-chip"><i class="fas fa-brain me-1" style="color:var(--fc-analisis);" aria-hidden="true"></i>Inteligencia</span>
                <span class="fc-chip"><i class="fas fa-chart-line me-1" style="color:var(--fc-logro);" aria-hidden="true"></i>Progreso</span>
                <span class="fc-chip"><i class="fas fa-dumbbell me-1" style="color:var(--fc-recuperar);" aria-hidden="true"></i>Fuerza</span>
                <span class="fc-chip"><i class="fas fa-shield-halved me-1" style="color:var(--fc-reco);" aria-hidden="true"></i>Compromiso</span>
            </div>
        </div>
        <div class="col-md-6 fc-hero-wolf-col">
            <img src="~/images/koda/koda-principal.png" alt="Koda" class="fc-wolf-hero koda-glow koda-idle koda-interactive" data-koda-aura />
        </div>
    </div>
</div>

@* ===== ELIGE TU OBJETIVO ===== *@
<div class="mb-2">
    <h2 class="mb-1">Elige tu objetivo</h2>
    <p class="text-muted">Cada uno arma una rutina y un plan distintos.</p>
</div>
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="fc-feature-card h-100" style="border-top:var(--px) solid var(--fc-recuperar);">
            <div class="fc-feature-icon" style="background: rgba(246,167,35,0.15); color:var(--fc-recuperar);">
                <i class="fas fa-fire-flame-curved fa-lg" aria-hidden="true"></i>
            </div>
            <h5 class="mt-3 mb-2">Quema de Grasa</h5>
            <p class="text-muted small mb-0">Full Body con cardio. 3 días por semana.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="fc-feature-card h-100" style="border-top:var(--px) solid var(--fc-primary);">
            <div class="fc-feature-icon" style="background: rgba(47,107,255,0.15); color:var(--fc-primary-texto);">
                <i class="fas fa-arrows-rotate fa-lg" aria-hidden="true"></i>
            </div>
            <h5 class="mt-3 mb-2">Recomposición Corporal</h5>
            <p class="text-muted small mb-0">Fuerza e hipertrofia. 4 días Torso/Pierna.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="fc-feature-card h-100" style="border-top:var(--px) solid var(--fc-logro);">
            <div class="fc-feature-icon" style="background: rgba(39,209,124,0.15); color:var(--fc-logro);">
                <i class="fas fa-dumbbell fa-lg" aria-hidden="true"></i>
            </div>
            <h5 class="mt-3 mb-2">Ganancia Muscular</h5>
            <p class="text-muted small mb-0">Hipertrofia máxima. 5 días de volumen.</p>
        </div>
    </div>
</div>

@* ===== LO QUE KODA HACE POR TI ===== *@
<div class="mb-2">
    <h2 class="mb-1">Todo lo que Koda hace por ti</h2>
    <p class="text-muted">No es un chat suelto. Es tu plan completo, con un coach adentro.</p>
</div>
<div class="row g-3 mb-5">
    <div class="col-md-6 col-lg-4">
        <div class="fc-feature-card h-100 d-flex gap-3">
            <i class="fas fa-fire fa-lg mt-1" style="color:var(--fc-entrenar);" aria-hidden="true"></i>
            <div><h6 class="mb-1">Rutinas con demostración</h6><p class="text-muted small mb-0">Cada ejercicio con su GIF y su técnica.</p></div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="fc-feature-card h-100 d-flex gap-3">
            <i class="fas fa-utensils fa-lg mt-1" style="color:var(--fc-recuperar);" aria-hidden="true"></i>
            <div><h6 class="mb-1">Nutrición a tu medida</h6><p class="text-muted small mb-0">Macros para tu objetivo, con lo que sí comes.</p></div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="fc-feature-card h-100 d-flex gap-3">
            <i class="fas fa-book-open fa-lg mt-1" style="color:var(--fc-reco);" aria-hidden="true"></i>
            <div><h6 class="mb-1">Diario de comidas</h6><p class="text-muted small mb-0">Anota lo del día y mira cuánto te queda.</p></div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="fc-feature-card h-100 d-flex gap-3">
            <i class="fas fa-robot fa-lg mt-1" style="color:var(--fc-analisis);" aria-hidden="true"></i>
            <div><h6 class="mb-1">Koda, tu coach IA</h6><p class="text-muted small mb-0">Te analiza con tus datos, no con consejos genéricos.</p></div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="fc-feature-card h-100 d-flex gap-3">
            <i class="fas fa-trophy fa-lg mt-1" style="color:var(--fc-logro);" aria-hidden="true"></i>
            <div><h6 class="mb-1">Niveles y logros</h6><p class="text-muted small mb-0">Ganas XP entrenando y subes de nivel.</p></div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="fc-feature-card h-100 d-flex gap-3">
            <i class="fas fa-chart-line fa-lg mt-1" style="color:var(--fc-primary-texto);" aria-hidden="true"></i>
            <div><h6 class="mb-1">Progreso visible</h6><p class="text-muted small mb-0">Peso, récords y rachas en una gráfica.</p></div>
        </div>
    </div>
</div>

@* ===== CTA FINAL ===== *@
<div class="fc-feature-card text-center py-5 mb-2" style="border-color:var(--fc-primary-texto);">
    <h3 class="mb-2">¿Listo para empezar, campeón?</h3>
    <p class="text-muted mb-4">Dinos tu objetivo y Koda arma todo en segundos.</p>
    @if (conSesion)
    {
        <a asp-controller="Perfil" asp-action="Index" class="btn fc-btn-primary px-5 py-2">
            <i class="fas fa-bolt me-2" aria-hidden="true"></i>Empezar ahora
        </a>
    }
    else
    {
        <a asp-controller="Account" asp-action="Register" class="btn fc-btn-primary px-5 py-2">
            <i class="fas fa-bolt me-2" aria-hidden="true"></i>Empezar ahora
        </a>
    }
</div>
