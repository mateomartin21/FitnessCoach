@using FitnessCoach.Domain.Catalogos
@using FitnessCoach.Domain.Models.Entrenamiento
@model FitnessCoach.Models.CambiarEjercicioViewModel
@{
    ViewData["Title"] = "Cambiar ejercicio";
}

<div class="mb-4">
    <span class="fc-tag">Tu rutina</span>
    <h1 class="fc-ajustes-titulo">Cambiar ejercicio</h1>
    <p class="text-muted mb-0">
        Todos trabajan <strong>@EtiquetasEjercicio.GrupoMuscular(Model.EnUso.GrupoMuscular)</strong>, así que tu rutina sigue cuadrando.
    </p>
</div>

@if (TempData["RutinaError"] is string error)
{
    <div class="alert fc-alerta-error d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="fas fa-circle-exclamation" aria-hidden="true"></i><span class="small">@error</span>
    </div>
}

<section class="fc-ajuste-bloque mb-4">
    <div class="fc-ajuste-cabeza">
        <i class="fas fa-bolt" aria-hidden="true"></i>
        <h2 class="fc-ajuste-titulo">Ahora tienes</h2>
    </div>
    <div class="d-flex align-items-center gap-3 flex-wrap">
        @{
            var mediosActual = FabricaMediosEjercicio.Crear(Model.EnUso);
            var gifActual = mediosActual.FirstOrDefault(m => m.Tipo == TipoMedio.Gif).Url;
        }
        <img src="@(gifActual ?? FabricaMediosEjercicio.RutaPlaceholder)" alt="" loading="lazy"
             class="fc-alt-gif"
             onerror="this.onerror=null; this.src='@FabricaMediosEjercicio.RutaPlaceholder';" />
        <div>
            <div class="fc-equipo-titulo">@Model.EnUso.Nombre</div>
            <div class="fc-equipo-detalle">@EtiquetasEjercicio.Equipo(Model.EnUso.Equipo)</div>
        </div>
        @if (Model.EsSustituido)
        {
            <form asp-action="Restaurar" method="post" class="ms-auto">
                <input type="hidden" name="slugReferencia" value="@Model.SlugReferencia" />
                <button type="submit" class="btn fc-btn-outline px-3 py-2">
                    <i class="fas fa-rotate-left me-2" aria-hidden="true"></i>Volver al de Koda
                </button>
            </form>
        }
    </div>
</section>

<section class="fc-ajuste-bloque">
    <div class="fc-ajuste-cabeza">
        <i class="fas fa-right-left" aria-hidden="true"></i>
        <h2 class="fc-ajuste-titulo">Cámbialo por</h2>
    </div>

    <form asp-action="Cambiar" method="get" class="fc-alt-buscador mb-3">
        <input type="hidden" name="slug" value="@Model.SlugReferencia" />
        <label for="q" class="visually-hidden">Buscar entre las alternativas</label>
        <input type="search" name="q" id="q" value="@Model.Busqueda" class="form-control"
               placeholder="Busca por nombre: flexión, press, polea…" />
        <button type="submit" class="btn fc-btn-outline px-3 py-2">
            <i class="fas fa-magnifying-glass" aria-hidden="true"></i><span class="visually-hidden">Buscar</span>
        </button>
        @if (!string.IsNullOrWhiteSpace(Model.Busqueda))
        {
            <a asp-action="Cambiar" asp-route-slug="@Model.SlugReferencia" class="btn fc-btn-outline px-3 py-2">Limpiar</a>
        }
    </form>

    @if (Model.HayMasDeLasQueSeVen)
    {
        <p class="text-muted small">
            Hay <strong>@Model.TotalAlternativas</strong> ejercicios que trabajan lo mismo.
            Se muestran los primeros @Model.Alternativas.Count; busca por nombre para afinar.
        </p>
    }

    @if (Model.Alternativas.Count == 0)
    {
        <p class="text-muted mb-0">
            @(string.IsNullOrWhiteSpace(Model.Busqueda)
                ? "No hay otro ejercicio de este grupo en el catálogo."
                : "Ningún ejercicio de este grupo coincide con tu búsqueda.")
        </p>
    }
    else
    {
        <div class="fc-alt-rejilla">
            @foreach (var alternativa in Model.Alternativas)
            {
                var medios = FabricaMediosEjercicio.Crear(alternativa);
                var gif = medios.FirstOrDefault(m => m.Tipo == TipoMedio.Gif).Url;

                <form asp-action="GuardarCambio" method="post" class="fc-alt-opcion">
                    <input type="hidden" name="slugReferencia" value="@Model.SlugReferencia" />
                    <input type="hidden" name="slugElegido" value="@alternativa.Slug" />
                    <img src="@(gif ?? FabricaMediosEjercicio.RutaPlaceholder)" alt="" loading="lazy"
                         class="fc-alt-gif"
                         onerror="this.onerror=null; this.src='@FabricaMediosEjercicio.RutaPlaceholder';" />
                    <div class="fc-alt-texto">
                        <span class="fc-equipo-titulo">@alternativa.Nombre</span>
                        <span class="fc-equipo-detalle">@EtiquetasEjercicio.Equipo(alternativa.Equipo)</span>
                    </div>
                    <button type="submit" class="btn fc-btn-outline px-3 py-2">
                        Elegir<span class="visually-hidden"> @alternativa.Nombre</span>
                    </button>
                </form>
            }
        </div>
    }
</section>

<div class="mt-4">
    <a asp-action="Index" class="btn fc-btn-outline px-4 py-2">
        <i class="fas fa-arrow-left me-2" aria-hidden="true"></i>Volver a la rutina
    </a>
</div>
