@{
    ViewData["Title"] = "IA Coach";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="fc-feature-card mb-0">
            <div class="d-flex align-items-center gap-3">
                <img src="~/images/koda/koda-logo.png" alt="Koda" data-koda="chat" data-koda-aura class="koda-glow koda-idle koda-interactive" style="height:88px; width:auto; image-rendering:pixelated;" />
                <div>
                    <h5 class="fw-bold mb-0" style="color:var(--fc-primary);">Koda</h5>
                    <small class="text-muted">Tu entrenador personal con IA</small>
                    <div class="d-flex align-items-center gap-1 mt-1">
                        <span style="width:8px;height:8px;border-radius:50%;background:var(--fc-logro);display:inline-block;"></span>
                        <small style="color:var(--fc-logro); font-size:0.7rem;">En línea</small>
                    </div>
                </div>
            </div>
        </div>

        <div id="chat-messages" style="background:var(--fc-inset); border-left:var(--px) solid var(--fc-ink); border-right:var(--px) solid var(--fc-ink); height:460px; overflow-y:auto; padding:1.5rem;">
            <div class="fc-msg fc-msg-bot mb-3">
                <img src="~/images/koda/koda-logo.png" alt="Koda" class="fc-msg-avatar" />
                <div class="fc-msg-bubble fc-msg-bubble-bot">
                    ¡Hola! Soy Koda, tu entrenador. Tengo acceso a tu perfil y te puedo ayudar con rutinas, nutrición, técnica de ejercicios o motivación. ¿Qué necesitas hoy?
                </div>
            </div>
        </div>

        <div class="fc-feature-card" style="border-top: var(--px) solid var(--fc-ink);">
            <div class="d-flex gap-2">
                <input type="text" id="user-input" class="form-control" placeholder="Escribe tu consulta a Koda..." />
                <button id="send-btn" class="btn fc-btn-primary px-4" onclick="enviarMensaje()">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
            <div class="d-flex gap-2 mt-2 flex-wrap">
                <button class="btn fc-chip" onclick="preguntaRapida(this)">¿Cómo mejorar mi sentadilla?</button>
                <button class="btn fc-chip" onclick="preguntaRapida(this)">¿Qué comer antes de entrenar?</button>
                <button class="btn fc-chip" onclick="preguntaRapida(this)">Motívame para hoy</button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script>
    function preguntaRapida(btn) {
        document.getElementById('user-input').value = btn.textContent;
        enviarMensaje();
    }

    async function enviarMensaje() {
        const input = document.getElementById('user-input');
        const mensaje = input.value.trim();
        if (!mensaje) return;

        agregarMensaje(mensaje, 'user');
        input.value = '';

        const typing = agregarTyping();
        if (window.Koda) Koda.chatThinking();

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const res = await fetch('/IaCoach/Consultar', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ mensaje })
            });
            const data = await res.json();
            typing.remove();
            agregarMensaje(data.respuesta, 'bot');
            if (window.Koda) Koda.chatAnswered();
        } catch {
            typing.remove();
            agregarMensaje('Hubo un error al conectar con el coach. Intenta de nuevo.', 'bot');
            if (window.Koda) Koda.chatError();
        }
    }

    function agregarMensaje(texto, tipo) {
        const container = document.getElementById('chat-messages');
        const div = document.createElement('div');
        div.className = `fc-msg fc-msg-${tipo} mb-3`;

        if (tipo === 'bot') {
            div.innerHTML = `
                <img src="/images/koda/koda-logo.png" alt="Bot" class="fc-msg-avatar" />
                <div class="fc-msg-bubble fc-msg-bubble-bot">${texto}</div>`;
        } else {
            div.innerHTML = `
                <div class="fc-msg-bubble fc-msg-bubble-user">${texto}</div>
                <div class="fc-msg-avatar-user"><i class="fas fa-user"></i></div>`;
        }

        container.appendChild(div);
        container.scrollTop = container.scrollHeight;
        return div;
    }

    function agregarTyping() {
        const container = document.getElementById('chat-messages');
        const div = document.createElement('div');
        div.className = 'fc-msg fc-msg-bot mb-3';
        div.innerHTML = `
            <img src="/images/koda/koda-logo.png" alt="Bot" class="fc-msg-avatar" />
            <div class="fc-msg-bubble fc-msg-bubble-bot">
                <span class="fc-typing"><span></span><span></span><span></span></span>
            </div>`;
        container.appendChild(div);
        container.scrollTop = container.scrollHeight;
        return div;
    }

    document.getElementById('user-input').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') enviarMensaje();
    });
</script>
}
