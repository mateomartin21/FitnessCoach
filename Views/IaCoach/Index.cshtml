@{
    ViewData["Title"] = "IA Coach";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="fc-feature-card mb-0" style="border-radius: 16px 16px 0 0;">
            <div class="d-flex align-items-center gap-3">
                <img src="~/images/branding/principal.png" alt="Lobo Coach" style="height:70px; width:auto; filter: drop-shadow(0 0 10px rgba(255,107,53,0.5));" />
                <div>
                    <h5 class="fw-bold mb-0" style="color:var(--fc-primary);">Lobo Coach</h5>
                    <small class="text-muted">Entrenador Personal con IA — Gemini 2.0 Flash</small>
                    <div class="d-flex align-items-center gap-1 mt-1">
                        <span style="width:8px;height:8px;border-radius:50%;background:#22c55e;display:inline-block;"></span>
                        <small style="color:#22c55e; font-size:0.7rem;">En linea</small>
                    </div>
                </div>
            </div>
        </div>

        <div id="chat-messages" style="background:#0f0f1a; border-left:1px solid #2a2a4a; border-right:1px solid #2a2a4a; height:460px; overflow-y:auto; padding:1.5rem;">
            <div class="fc-msg fc-msg-bot mb-3">
                <img src="~/images/branding/logo.png" alt="Bot" class="fc-msg-avatar" />
                <div class="fc-msg-bubble fc-msg-bubble-bot">
                    Hola, soy tu Lobo Coach. Tengo acceso a tu perfil y te puedo ayudar con rutinas, nutricion, tecnica de ejercicios o motivacion. Que necesitas hoy?
                </div>
            </div>
        </div>

        <div class="fc-feature-card" style="border-radius: 0 0 16px 16px; border-top: 1px solid #2a2a4a;">
            <div class="d-flex gap-2">
                <input type="text" id="user-input" class="form-control" placeholder="Escribe tu consulta al Lobo Coach..." />
                <button id="send-btn" class="btn fc-btn-primary px-4" onclick="enviarMensaje()">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
            <div class="d-flex gap-2 mt-2 flex-wrap">
                <button class="btn fc-chip" onclick="preguntaRapida(this)">Como mejorar mi sentadilla?</button>
                <button class="btn fc-chip" onclick="preguntaRapida(this)">Que comer antes de entrenar?</button>
                <button class="btn fc-chip" onclick="preguntaRapida(this)">Motivame para hoy</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function preguntaRapida(btn) {
        document.getElementById('user-input').value = btn.textContent;
        enviarMensaje();
    }

    async function enviarMensaje() {
        const input = document.getElementById('user-input');
        const mensaje = input.value.trim();
        if (!mensaje) return;

        agregarMensaje(mensaje, 'user');
        input.value = '';

        const typing = agregarTyping();

        try {
            const res = await fetch('/IaCoach/Consultar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ mensaje })
            });
            const data = await res.json();
            typing.remove();
            agregarMensaje(data.respuesta, 'bot');
        } catch {
            typing.remove();
            agregarMensaje('Hubo un error al conectar con el coach. Intenta de nuevo.', 'bot');
        }
    }

    function agregarMensaje(texto, tipo) {
        const container = document.getElementById('chat-messages');
        const div = document.createElement('div');
        div.className = `fc-msg fc-msg-${tipo} mb-3`;

        if (tipo === 'bot') {
            div.innerHTML = `
                <img src="/images/branding/logo.png" alt="Bot" class="fc-msg-avatar" />
                <div class="fc-msg-bubble fc-msg-bubble-bot">${texto}</div>`;
        } else {
            div.innerHTML = `
                <div class="fc-msg-bubble fc-msg-bubble-user">${texto}</div>
                <div class="fc-msg-avatar-user"><i class="fas fa-user"></i></div>`;
        }

        container.appendChild(div);
        container.scrollTop = container.scrollHeight;
        return div;
    }

    function agregarTyping() {
        const container = document.getElementById('chat-messages');
        const div = document.createElement('div');
        div.className = 'fc-msg fc-msg-bot mb-3';
        div.innerHTML = `
            <img src="/images/branding/logo.png" alt="Bot" class="fc-msg-avatar" />
            <div class="fc-msg-bubble fc-msg-bubble-bot">
                <span class="fc-typing"><span></span><span></span><span></span></span>
            </div>`;
        container.appendChild(div);
        container.scrollTop = container.scrollHeight;
        return div;
    }

    document.getElementById('user-input').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') enviarMensaje();
    });
</script>
}
