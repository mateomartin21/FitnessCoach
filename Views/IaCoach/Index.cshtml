@{
    ViewData["Title"] = "IA Coach";
}

@* Cabecera, conversación y caja de escribir son UNA sola superficie. Antes eran
   tres cajas apiladas, cada una con su borde: se leía como tres módulos sueltos
   en vez de como un chat. *@
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="fc-chat">
            <div class="fc-chat-cabeza">
                <img src="~/images/koda/koda-logo.png" alt="Koda" data-koda="chat" data-koda-aura class="fc-chat-koda koda-glow koda-idle koda-interactive" />
                <div>
                    <h1 class="fc-chat-nombre">Koda</h1>
                    <span class="fc-chat-estado"><span class="fc-punto-vivo" aria-hidden="true"></span>En línea · ve tus datos reales</span>
                </div>
            </div>

            <div id="chat-messages" role="log" aria-live="polite" aria-label="Conversación con Koda" class="fc-chat-hilo">
                <div class="fc-msg fc-msg-bot mb-3">
                    <img src="~/images/koda/koda-logo.png" alt="Koda" class="fc-msg-avatar" />
                    <div class="fc-msg-bubble fc-msg-bubble-bot fc-respuesta">
                        <p>Soy Koda y ya vi tu perfil, tu rutina y lo que comiste hoy.</p>
                        <p>Pregúntame lo que sea. <strong>¿Por dónde empezamos?</strong></p>
                    </div>
                </div>
            </div>

            <div class="fc-chat-pie">
                <div class="fc-chat-sugerencias">
                    <button class="btn fc-chip" onclick="preguntaRapida(this)">¿Cómo va mi semana?</button>
                    <button class="btn fc-chip" onclick="preguntaRapida(this)">¿Qué como antes de entrenar?</button>
                    <button class="btn fc-chip" onclick="preguntaRapida(this)">Motívame</button>
                </div>
                <div class="fc-chat-escribir">
                    <input type="text" id="user-input" class="form-control" placeholder="Escríbele a Koda…" aria-label="Tu consulta para Koda" autocomplete="off" />
                    <button id="send-btn" class="btn fc-btn-primary" onclick="enviarMensaje()" aria-label="Enviar mensaje">
                        <i class="fas fa-paper-plane" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script>
    function preguntaRapida(btn) {
        document.getElementById('user-input').value = btn.textContent;
        enviarMensaje();
    }

    async function enviarMensaje() {
        const input = document.getElementById('user-input');
        const mensaje = input.value.trim();
        if (!mensaje) return;

        agregarMensaje(mensaje, 'user');
        input.value = '';

        const typing = agregarTyping();
        if (window.Koda) Koda.chatThinking();

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const res = await fetch('/IaCoach/Consultar', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ mensaje })
            });
            const data = await res.json();
            typing.remove();
            agregarMensaje(data.respuesta, 'bot');
            if (window.Koda) Koda.chatAnswered();
        } catch {
            typing.remove();
            agregarMensaje('Hubo un error al conectar con el coach. Intenta de nuevo.', 'bot');
            if (window.Koda) Koda.chatError();
        }
    }

    // Ni la respuesta de la IA ni lo que escribe el usuario se interpolan crudo en
    // innerHTML: la del bot pasa por Koda.pintar (escapa y aplica su markdown mínimo)
    // y la del usuario por textContent, que no interpreta nada.
    function agregarMensaje(texto, tipo) {
        const container = document.getElementById('chat-messages');
        const div = document.createElement('div');
        div.className = `fc-msg fc-msg-${tipo} mb-3`;

        if (tipo === 'bot') {
            div.innerHTML = `
                <img src="/images/koda/koda-logo.png" alt="Bot" class="fc-msg-avatar" />
                <div class="fc-msg-bubble fc-msg-bubble-bot fc-respuesta"></div>`;
            const globo = div.querySelector('.fc-respuesta');
            if (window.Koda) Koda.pintar(globo, texto); else globo.textContent = texto;
        } else {
            div.innerHTML = `
                <div class="fc-msg-bubble fc-msg-bubble-user"></div>
                <div class="fc-msg-avatar-user"><i class="fas fa-user" aria-hidden="true"></i></div>`;
            div.querySelector('.fc-msg-bubble-user').textContent = texto;
        }

        container.appendChild(div);
        container.scrollTop = container.scrollHeight;
        return div;
    }

    function agregarTyping() {
        const container = document.getElementById('chat-messages');
        const div = document.createElement('div');
        div.className = 'fc-msg fc-msg-bot mb-3';
        div.innerHTML = `
            <img src="/images/koda/koda-logo.png" alt="Bot" class="fc-msg-avatar" />
            <div class="fc-msg-bubble fc-msg-bubble-bot">
                <span class="fc-typing"><span></span><span></span><span></span></span>
            </div>`;
        container.appendChild(div);
        container.scrollTop = container.scrollHeight;
        return div;
    }

    document.getElementById('user-input').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') enviarMensaje();
    });
</script>
}
