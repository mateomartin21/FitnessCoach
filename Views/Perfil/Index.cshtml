@model FitnessCoach.Models.PerfilViewModel
@{
    ViewData["Title"] = "Mi Perfil";
    var calorias = ViewBag.CaloriasRecomendadas;
}

@* Resumen arriba y a lo ancho, formulario abajo. Antes eran dos tarjetas lado a lado
   forzadas a la misma altura, y la de resultados quedaba con un hueco muerto grande. *@
<section class="fc-perfil-resumen mb-4">
    <div class="fc-perfil-identidad">
        <img src="~/images/koda/koda-listo.png" alt="" class="fc-perfil-koda" />
        <div>
            <span class="fc-tag">Tu perfil</span>
            <h1 class="fc-perfil-nombre">@(string.IsNullOrWhiteSpace(Model.Nombre) ? "Sin nombre" : Model.Nombre)</h1>
            <p class="fc-perfil-objetivo mb-0">@ViewBag.ObjetivoNombre</p>
        </div>
    </div>

    <div class="fc-perfil-calorias">
        <span class="fc-stat-label d-block">Calorías diarias recomendadas</span>
        @if (calorias is null)
        {
            <span class="fc-perfil-kcal fc-perfil-kcal-vacio">—</span>
            <p class="small text-muted mb-0 mt-1">Completa el formulario para calcularlas.</p>
        }
        else
        {
            <span class="fc-perfil-kcal">@calorias</span>
            <span class="fc-perfil-kcal-unidad">kcal/día</span>
            <p class="small text-muted mb-0 mt-1">Fórmula Mifflin-St Jeor</p>
        }
    </div>
</section>

<div class="fc-info-bar d-flex flex-wrap mb-4">
    <div class="fc-stat flex-fill text-center border-end">
        <div class="fc-stat-num">@Model.Edad</div>
        <div class="fc-stat-label">AÑOS</div>
    </div>
    <div class="fc-stat flex-fill text-center border-end">
        <div class="fc-stat-num">@Model.PesoKg</div>
        <div class="fc-stat-label">KG</div>
    </div>
    <div class="fc-stat flex-fill text-center border-end">
        <div class="fc-stat-num">@Model.EstaturaCm</div>
        <div class="fc-stat-label">CM DE ESTATURA</div>
    </div>
    <div class="fc-stat flex-fill text-center">
        <div class="fc-stat-num">@(Model.EstaturaCm > 0 ? Math.Round(Model.PesoKg / Math.Pow(Model.EstaturaCm / 100.0, 2), 1) : 0)</div>
        <div class="fc-stat-label">ÍNDICE DE MASA CORPORAL</div>
    </div>
</div>

<div class="card shadow">
    <div class="card-header py-3" style="border-left: 4px solid var(--fc-primary);">
        <h5 class="mb-0"><i class="fas fa-user-edit me-2" style="color:var(--fc-primary-texto);" aria-hidden="true"></i>Actualizar perfil</h5>
    </div>
    <div class="card-body">
        <form asp-controller="Perfil" asp-action="GuardarPerfil" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="row g-3">
                <div class="col-12 col-lg-6">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>
                <div class="col-6 col-lg-3">
                    <label asp-for="Edad" class="form-label"></label>
                    <input asp-for="Edad" type="number" class="form-control" />
                    <span asp-validation-for="Edad" class="text-danger small"></span>
                </div>
                <div class="col-6 col-lg-3">
                    <label asp-for="PesoKg" class="form-label"></label>
                    <input asp-for="PesoKg" type="number" step="0.1" class="form-control" />
                    <span asp-validation-for="PesoKg" class="text-danger small"></span>
                </div>

                <div class="col-6 col-lg-3">
                    <label asp-for="EstaturaCm" class="form-label"></label>
                    <input asp-for="EstaturaCm" type="number" step="0.1" class="form-control" />
                    <span asp-validation-for="EstaturaCm" class="text-danger small"></span>
                </div>
                <div class="col-12 col-lg-9">
                    <label asp-for="TipoObjetivo" class="form-label"></label>
                    <select asp-for="TipoObjetivo" class="form-select">
                        <option value="Perder">Pérdida de grasa</option>
                        <option value="Musculo">Ganar músculo</option>
                        <option value="Recomp">Recomposición corporal</option>
                    </select>
                    <span asp-validation-for="TipoObjetivo" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn fc-btn-primary px-4 py-2">
                    <i class="fas fa-save me-2" aria-hidden="true"></i>Guardar y calcular
                </button>
                <a asp-controller="Rutinas" asp-action="Index" class="btn fc-btn-outline px-4 py-2">
                    <i class="fas fa-fire me-2" aria-hidden="true"></i>Ver mi rutina
                </a>
                <a asp-controller="Ajustes" asp-action="Index" class="btn fc-btn-outline px-4 py-2">
                    <i class="fas fa-gear me-2" aria-hidden="true"></i>Ajustes
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
