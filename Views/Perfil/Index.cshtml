@model FitnessCoach.Models.PerfilViewModel
@using FitnessCoach.Application.Services
@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="row g-4">
    <div class="col-md-6">
        <div class="card shadow h-100">
            <div class="card-header py-3" style="border-left: 4px solid var(--fc-primary);">
                <h5 class="mb-0"><i class="fas fa-user-edit me-2" style="color:var(--fc-primary-texto);" aria-hidden="true"></i>Actualizar Perfil</h5>
            </div>
            <div class="card-body">
                <form asp-controller="Perfil" asp-action="GuardarPerfil" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label asp-for="Edad" class="form-label"></label>
                            <input asp-for="Edad" type="number" class="form-control" />
                            <span asp-validation-for="Edad" class="text-danger small"></span>
                        </div>
                        <div class="col-6 mb-3">
                            <label asp-for="PesoKg" class="form-label"></label>
                            <input asp-for="PesoKg" type="number" step="0.1" class="form-control" />
                            <span asp-validation-for="PesoKg" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EstaturaCm" class="form-label"></label>
                        <input asp-for="EstaturaCm" type="number" step="0.1" class="form-control" />
                        <span asp-validation-for="EstaturaCm" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="TipoObjetivo" class="form-label"></label>
                        <select asp-for="TipoObjetivo" class="form-select">
                            <option value="Perder">Pérdida de Grasa</option>
                            <option value="Musculo">Ganar Músculo</option>
                            <option value="Recomp">Recomposición Corporal</option>
                        </select>
                        <span asp-validation-for="TipoObjetivo" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ZonaHoraria" class="form-label"></label>
                        <select asp-for="ZonaHoraria" class="form-select" id="selectZonaHoraria"
                                data-sin-zona="@(string.IsNullOrWhiteSpace(Model.ZonaHoraria) ? "true" : "false")">
                            @foreach (var zona in ZonaHorariaUsuario.Comunes)
                            {
                                <option value="@zona.Id">@zona.Etiqueta</option>
                            }
                        </select>
                        <div class="form-text">Tu racha, tus misiones y el día del diario se cuentan con tu medianoche, no la del servidor.</div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-2">
                        <i class="fas fa-save me-2" aria-hidden="true"></i>Guardar y Calcular
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow h-100">
            <div class="card-header py-3" style="border-left: 4px solid #00d4ff;">
                <h5 class="mb-0"><i class="fas fa-chart-bar me-2" style="color:#00d4ff;" aria-hidden="true"></i>Tu Plan Personalizado</h5>
            </div>
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h3 class="fw-bold mb-1" style="color:var(--fc-primary-texto);">@Model.Nombre</h3>
                    <p class="text-muted small mb-3">Resultados basados en fórmula Mifflin-St Jeor</p>

                    <div class="p-3 mb-3 rounded" style="background:#0f0f1a; border:1px solid #2a2a4a;">
                        <small class="text-muted text-uppercase">Objetivo Actual</small>
                        <p class="h5 mb-0 mt-1">@ViewBag.ObjetivoNombre</p>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-4">
                            <div class="p-2 rounded text-center" style="background:#0f0f1a; border:1px solid #2a2a4a;">
                                <small class="text-muted d-block">Edad</small>
                                <strong>@Model.Edad años</strong>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 rounded text-center" style="background:#0f0f1a; border:1px solid #2a2a4a;">
                                <small class="text-muted d-block">Peso</small>
                                <strong>@Model.PesoKg kg</strong>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 rounded text-center" style="background:#0f0f1a; border:1px solid #2a2a4a;">
                                <small class="text-muted d-block">Estatura</small>
                                <strong>@Model.EstaturaCm cm</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="p-4 rounded text-center mt-2" style="background: linear-gradient(135deg, #1a1a2e, #16213e); border: 2px solid var(--fc-primary);">
                    <small class="text-muted text-uppercase d-block mb-1">Calorías Diarias Recomendadas</small>
                    @if (ViewBag.CaloriasRecomendadas is null)
                    {
                        <span class="display-4 fw-bold text-muted">—</span>
                        <p class="small text-muted mb-0 mt-2">Corregí los datos del formulario para volver a calcular.</p>
                    }
                    else
                    {
                        <span class="display-4 fw-bold" style="color:var(--fc-primary-texto);">@ViewBag.CaloriasRecomendadas</span>
                        <span class="h5 text-muted ms-1">kcal/día</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="text-center mt-4">
    <a asp-controller="Rutinas" asp-action="Index" class="btn btn-primary px-5">
        <i class="fas fa-fire me-2" aria-hidden="true"></i>Ver Mi Rutina Personalizada
    </a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // El navegador ya sabe la zona del usuario. Si no está entre las comunes se agrega
        // como opción, y solo se preselecciona si el perfil no tiene una guardada (D-25).
        (function () {
            var select = document.getElementById('selectZonaHoraria');
            if (!select || !window.Intl) return;

            var detectada = Intl.DateTimeFormat().resolvedOptions().timeZone;
            if (!detectada) return;

            var existe = Array.prototype.some.call(select.options, function (o) { return o.value === detectada; });
            if (!existe) {
                var opcion = new Option(detectada + ' (detectada)', detectada);
                select.add(opcion, select.options[0]);
            }

            if (select.dataset.sinZona === 'true') select.value = detectada;
        })();
    </script>
}
