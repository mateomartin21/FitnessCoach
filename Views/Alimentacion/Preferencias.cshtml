@model FitnessCoach.Models.PreferenciasViewModel
@{
    ViewData["Title"] = "Mis preferencias alimentarias";
}

<div class="text-center mb-4">
    <h2 class="fw-bold" style="color:var(--fc-primary-texto);">Mis preferencias</h2>
    <p class="text-muted small mx-auto" style="max-width:620px;">
        Con esto ajustamos tu plan: nada de lo que marques como excluido va a aparecer,
        ni en las comidas ni como alternativa.
    </p>
</div>

<form asp-action="GuardarPreferencias" method="post">
    @Html.AntiForgeryToken()

    <div class="fc-feature-card mb-4">
        <h6 class="fw-bold mb-3" style="color:var(--fc-primary-texto);">
            <i class="fas fa-leaf me-2" aria-hidden="true"></i>Tipo de dieta
        </h6>
        <div class="row g-2">
            @foreach (var (valor, titulo, detalle) in FitnessCoach.Models.PreferenciasViewModel.DietasDisponibles)
            {
                var marcada = Model.Dietas.Contains(valor);
                <div class="col-md-6">
                    <label class="d-flex align-items-start gap-2 p-3 rounded h-100"
                           style="background:var(--fc-anidado); cursor:pointer;">
                        <input type="checkbox" name="Dietas" value="@valor" class="form-check-input mt-1"
                               @(marcada ? "checked" : "") />
                        <span>
                            <span class="fw-semibold" style="color:var(--fc-text);">@titulo</span>
                            <span class="d-block small text-muted">@detalle</span>
                        </span>
                    </label>
                </div>
            }
        </div>
    </div>

    <div class="fc-feature-card mb-4">
        <h6 class="fw-bold mb-1" style="color:var(--fc-primary-texto);">
            <i class="fas fa-ban me-2" aria-hidden="true"></i>Alimentos a excluir
        </h6>
        <p class="small text-muted mb-3">Por alergia o porque no te gustan. Marca los que no quieres ver nunca.</p>

        @foreach (var grupo in Model.CatalogoPorCategoria)
        {
            <div class="mb-3">
                <div class="text-uppercase small fw-bold mb-2" style="color:var(--fc-muted); letter-spacing:0.05em;">
                    @grupo.Key
                </div>
                <div class="row g-2">
                    @foreach (var alimento in grupo.OrderBy(a => a.Nombre))
                    {
                        var excluido = Model.AlimentosExcluidos.Contains(alimento.Slug);
                        <div class="col-6 col-md-4 col-lg-3">
                            <label class="d-flex align-items-center gap-2 p-2 rounded"
                                   style="background:var(--fc-anidado); cursor:pointer;">
                                <input type="checkbox" name="AlimentosExcluidos" value="@alimento.Slug"
                                       class="form-check-input" @(excluido ? "checked" : "") />
                                <span class="small" style="color:var(--fc-text);">@alimento.Nombre</span>
                            </label>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="text-center mb-4">
        <button type="submit" class="btn fc-btn-primary px-4 me-2">
            <i class="fas fa-save me-2" aria-hidden="true"></i>Guardar preferencias
        </button>
        <a asp-action="Index" class="btn fc-btn-outline px-4">
            <i class="fas fa-utensils me-2" aria-hidden="true"></i>Ver mi plan
        </a>
    </div>
</form>
