@model FitnessCoach.Models.EditarRegistroViewModel
@{
    ViewData["Title"] = "Editar registro";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header py-3" style="border-left: 4px solid var(--fc-primary);">
                <h5 class="mb-0"><i class="fas fa-pen me-2" style="color:var(--fc-primary);"></i>Editar registro</h5>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-4">
                    Registrado el @Model.Fecha.ToLocalTime().ToString("dd/MM/yyyy 'a las' HH:mm").
                    La fecha no se modifica: es cuándo ocurrió.
                </p>

                <form asp-controller="Progreso" asp-action="Editar" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Fecha" />

                    <div class="mb-3">
                        <label asp-for="PesoKg" class="form-label"></label>
                        <input asp-for="PesoKg" type="number" step="0.1" class="form-control" />
                        <span asp-validation-for="PesoKg" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Notas" class="form-label"></label>
                        <textarea asp-for="Notas" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Notas" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1 py-2">
                            <i class="fas fa-save me-2"></i>Guardar cambios
                        </button>
                        <a asp-controller="Progreso" asp-action="Index" class="btn btn-outline-secondary px-4">
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
