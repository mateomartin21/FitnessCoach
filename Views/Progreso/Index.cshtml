@model FitnessCoach.Models.ProgresoViewModel
@{
    ViewData["Title"] = "Mi Progreso";
}

@if (TempData["MensajeProgreso"] != null)
{
    <div class="alert alert-success py-2 small">@TempData["MensajeProgreso"]</div>
}

<div class="row g-4">
    <div class="col-md-5">
        <div class="card shadow h-100">
            <div class="card-header py-3" style="border-left: 4px solid var(--fc-primary);">
                <h5 class="mb-0"><i class="fas fa-weight-scale me-2" style="color:var(--fc-primary);"></i>Registrar Peso</h5>
            </div>
            <div class="card-body">
                <form asp-controller="Progreso" asp-action="RegistrarPeso" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="Nuevo.NuevoPeso" class="form-label"></label>
                        <input asp-for="Nuevo.NuevoPeso" type="number" step="0.1" class="form-control" />
                        <span asp-validation-for="Nuevo.NuevoPeso" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Nuevo.Notas" class="form-label"></label>
                        <textarea asp-for="Nuevo.Notas" class="form-control" rows="3"
                                  placeholder="Cómo te sentiste, qué entrenaste..."></textarea>
                        <span asp-validation-for="Nuevo.Notas" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-2">
                        <i class="fas fa-plus me-2"></i>Guardar Registro
                    </button>
                </form>

                <div class="row g-2 mt-4">
                    <div class="col-6">
                        <div class="p-3 rounded text-center" style="background:#0f0f1a; border:1px solid #2a2a4a;">
                            <small class="text-muted d-block text-uppercase" style="font-size:0.7rem;">Peso actual</small>
                            <strong class="h5 mb-0 d-block mt-1">@Model.PesoActual kg</strong>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded text-center" style="background:#0f0f1a; border:1px solid #2a2a4a;">
                            <small class="text-muted d-block text-uppercase" style="font-size:0.7rem;">Variación total</small>
                            @if (Model.VariacionTotalKg is null)
                            {
                                <strong class="h5 mb-0 d-block mt-1 text-muted">—</strong>
                            }
                            else
                            {
                                var variacion = Model.VariacionTotalKg.Value;
                                <strong class="h5 mb-0 d-block mt-1" style="color:@(variacion <= 0 ? "#22c55e" : "#f59e0b");">
                                    @(variacion > 0 ? "+" : "")@variacion kg
                                </strong>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card shadow h-100">
            <div class="card-header py-3" style="border-left: 4px solid #00d4ff;">
                <h5 class="mb-0"><i class="fas fa-clock-rotate-left me-2" style="color:#00d4ff;"></i>Historial</h5>
            </div>
            <div class="card-body">
                @if (!Model.TieneRegistros)
                {
                    <div class="text-center py-5">
                        <i class="fas fa-chart-line mb-3" style="font-size:2.5rem; color:#2a2a4a;"></i>
                        <p class="text-muted mb-0">Todavía no registraste ningún peso.</p>
                        <p class="text-muted small">Anotá el primero y vas a poder seguir tu evolución acá.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle mb-0">
                            <thead>
                                <tr class="text-muted" style="font-size:0.75rem; text-transform:uppercase;">
                                    <th>Fecha</th>
                                    <th>Peso</th>
                                    <th>Cambio</th>
                                    <th>Notas</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Historial.Count; i++)
                                {
                                    var registro = Model.Historial[i];
                                    var cambio = Model.VariacionRespectoAlAnterior(i);
                                    <tr>
                                        <td class="small">@registro.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td><strong>@registro.PesoKg kg</strong></td>
                                        <td class="small">
                                            @if (cambio is null)
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                            else
                                            {
                                                <span style="color:@(cambio <= 0 ? "#22c55e" : "#f59e0b");">
                                                    @(cambio > 0 ? "+" : "")@cambio kg
                                                </span>
                                            }
                                        </td>
                                        <td class="small text-muted">
                                            @(string.IsNullOrWhiteSpace(registro.Notas) ? "—" : registro.Notas)
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <a asp-controller="Progreso" asp-action="Editar" asp-route-id="@registro.Id"
                                               class="btn btn-sm btn-outline-secondary" title="Editar">
                                                <i class="fas fa-pen"></i>
                                            </a>
                                            <form asp-controller="Progreso" asp-action="Eliminar" method="post"
                                                  class="d-inline m-0"
                                                  onsubmit="return confirm('¿Eliminar este registro? No se puede deshacer.');">
                                                <input type="hidden" name="id" value="@registro.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
