@model FitnessCoach.Models.ProgresoViewModel
@{
    ViewData["Title"] = "Mi Progreso";
    // Si acaba de caer un logro, Koda celebra; si no, aparece analizando datos.
    var logro = TempData["LogroDesbloqueado"] as string;
    var kodaProg = logro != null ? "koda-celebrando.png" : "koda-analizando.png";
}

<div class="d-flex align-items-center justify-content-center gap-3 mb-4 flex-wrap text-center text-sm-start">
    <img src="~/images/koda/@kodaProg" alt="Koda"
         class="d-none d-sm-block flex-shrink-0 koda-glow koda-idle koda-interactive" data-koda-aura
         data-koda-celebra="@(logro != null ? "" : null)"
         style="height:130px; width:auto; image-rendering:pixelated;" />
    <div>
        <h2 class="fw-bold mb-1" style="color:var(--fc-primary-texto);">Tu progreso</h2>
        <p class="text-muted mb-0 small">Koda revisa tus números, tus récords y tu constancia.</p>
    </div>
</div>

@if (TempData["MensajeProgreso"] != null)
{
    <div class="alert alert-success py-2 small">@TempData["MensajeProgreso"]</div>
}

@if (logro != null)
{
    <div class="alert fc-alerta-logro d-flex align-items-start gap-3 mb-4" style="white-space:pre-line;">
        <i class="fas fa-trophy mt-1" style="color:var(--fc-gold); font-size:1.4rem;" aria-hidden="true"></i>
        <div>@logro <a asp-controller="Gamificacion" asp-action="Index" class="d-block small mt-1" style="color:var(--fc-proteina);">Ver todos tus logros →</a></div>
    </div>
}

@* La IA como capa sobre los datos: el Lobo mira lo real y opina. Bajo demanda,
   para no gastar una llamada a la IA en cada carga de la pantalla. El resumen de
   la semana arriba; el análisis puntual del progreso, debajo. *@
<partial name="_AnalisisLobo" model="@("semana")" />
<partial name="_AnalisisLobo" model="@("progreso")" />

@* Los cuatro numeros del encabezado. La racha va resaltada por color, no por un
   borde mas grueso: cuatro recuadros con borde propio se leian como una reja. *@
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="fc-dato fc-dato-clave">
            <i class="fas fa-fire" aria-hidden="true"></i>
            <span class="fc-dato-rotulo">Racha actual</span>
            <span class="fc-dato-num">@Model.Rachas.Actual</span>
            <span class="fc-dato-unidad">@(Model.Rachas.Actual == 1 ? "día" : "días")</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="fc-dato">
            <i class="fas fa-trophy" aria-hidden="true"></i>
            <span class="fc-dato-rotulo">Mejor racha</span>
            <span class="fc-dato-num">@Model.Rachas.MasLarga</span>
            <span class="fc-dato-unidad">@(Model.Rachas.MasLarga == 1 ? "día" : "días")</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="fc-dato">
            <i class="fas fa-dumbbell" aria-hidden="true"></i>
            <span class="fc-dato-rotulo">Entrenamientos</span>
            <span class="fc-dato-num">@Model.Entrenamientos.Count</span>
            <span class="fc-dato-unidad">en total</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="fc-dato">
            <i class="fas fa-weight-scale" aria-hidden="true"></i>
            <span class="fc-dato-rotulo">Peso actual</span>
            <span class="fc-dato-num">@Model.PesoActual</span>
            <span class="fc-dato-unidad">kg</span>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-5">
        <div class="card shadow h-100">
            <div class="card-header py-3" style="border-left: 4px solid var(--fc-primary);">
                <h5 class="mb-0"><i class="fas fa-weight-scale me-2" style="color:var(--fc-primary-texto);" aria-hidden="true"></i>Registrar Peso</h5>
            </div>
            <div class="card-body">
                <form asp-controller="Progreso" asp-action="RegistrarPeso" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="Nuevo.NuevoPeso" class="form-label"></label>
                        <input asp-for="Nuevo.NuevoPeso" type="number" step="0.1" class="form-control" />
                        <span asp-validation-for="Nuevo.NuevoPeso" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Nuevo.Notas" class="form-label"></label>
                        <textarea asp-for="Nuevo.Notas" class="form-control" rows="3"
                                  placeholder="Cómo te sentiste, qué entrenaste..."></textarea>
                        <span asp-validation-for="Nuevo.Notas" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-2">
                        <i class="fas fa-plus me-2" aria-hidden="true"></i>Guardar Registro
                    </button>
                </form>

                @if (Model.VariacionTotalKg is not null)
                {
                    var variacion = Model.VariacionTotalKg.Value;
                    <div class="fc-dato mt-4">
                        <span class="fc-dato-rotulo">Desde tu primer registro</span>
                        <span class="fc-dato-num" style="color:@(variacion <= 0 ? "var(--fc-logro)" : "var(--fc-recuperar)");">
                            @(variacion > 0 ? "+" : "")@variacion<span class="fc-dato-unidad"> kg</span>
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card shadow h-100">
            <div class="card-header py-3" style="border-left: 4px solid var(--fc-proteina);">
                <h5 class="mb-0"><i class="fas fa-clock-rotate-left me-2" style="color:var(--fc-proteina);" aria-hidden="true"></i>Historial</h5>
            </div>
            <div class="card-body">
                @if (!Model.TieneRegistros)
                {
                    <div class="text-center py-5">
                        <i class="fas fa-chart-line mb-3" style="font-size:2.5rem; color:var(--fc-border);" aria-hidden="true"></i>
                        <p class="text-muted mb-0">Todavía no registraste ningún peso.</p>
                        <p class="text-muted small">Anota el primero y podrás seguir tu evolución aquí.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle mb-0 fc-tabla-lista">
                            <thead>
                                <tr class="text-muted" style="font-size:0.75rem; text-transform:uppercase;">
                                    <th scope="col">Fecha</th>
                                    <th scope="col">Peso</th>
                                    <th scope="col">Cambio</th>
                                    <th scope="col">Notas</th>
                                    <th scope="col" class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Historial.Count; i++)
                                {
                                    var registro = Model.Historial[i];
                                    var cambio = Model.VariacionRespectoAlAnterior(i);
                                    <tr>
                                        <td class="small fc-lista-pie">@Model.EnLocal(registro.Fecha).ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="fc-lista-titulo"><strong>@registro.PesoKg kg</strong></td>
                                        <td class="small fc-lista-dato">
                                            @if (cambio is null)
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                            else
                                            {
                                                <span style="color:@(cambio <= 0 ? "var(--fc-logro)" : "var(--fc-recuperar)");">
                                                    @(cambio > 0 ? "+" : "")@cambio kg
                                                </span>
                                            }
                                        </td>
                                        <td class="small text-muted fc-lista-nota" data-vacia="@string.IsNullOrWhiteSpace(registro.Notas)">
                                            @(string.IsNullOrWhiteSpace(registro.Notas) ? "—" : registro.Notas)
                                        </td>
                                        <td class="text-end text-nowrap fc-lista-acciones">
                                            <a asp-controller="Progreso" asp-action="Editar" asp-route-id="@registro.Id"
                                               class="btn btn-sm btn-outline-secondary" title="Editar">
                                                <i class="fas fa-pen" aria-hidden="true"></i>
                                            </a>
                                            <form asp-controller="Progreso" asp-action="Eliminar" method="post"
                                                  class="d-inline m-0"
                                                  onsubmit="return confirm('¿Eliminar este registro? No se puede deshacer.');">
                                                <input type="hidden" name="id" value="@registro.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                                    <i class="fas fa-trash" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-md-5">
        <div class="card shadow h-100">
            <div class="card-header py-3" style="border-left: 4px solid var(--fc-entrenar);">
                <h5 class="mb-0"><i class="fas fa-dumbbell me-2" style="color:var(--fc-entrenar);" aria-hidden="true"></i>Registrar Entrenamiento</h5>
            </div>
            <div class="card-body">
                <form asp-controller="Progreso" asp-action="RegistrarEntrenamiento" method="post">
                    <div class="mb-3">
                        <label asp-for="NuevoEntrenamiento.NombreRutina" class="form-label"></label>
                        @* Solo días reales de la rutina del usuario: no texto libre, para
                           que no se pueda marcar como hecho algo inventado y ganar el logro. *@
                        @if (Model.PuedeRegistrarEntrenamiento)
                        {
                            <select asp-for="NuevoEntrenamiento.NombreRutina" class="form-select">
                                <option value="">— Elige el día que entrenaste —</option>
                                @foreach (var opcion in Model.OpcionesRutina)
                                {
                                    <option value="@opcion">@opcion</option>
                                }
                            </select>
                            <span asp-validation-for="NuevoEntrenamiento.NombreRutina" class="text-danger small"></span>
                        }
                        else
                        {
                            <div class="small text-muted">
                                Define tu objetivo para ver tu rutina y poder registrar entrenamientos.
                                <a asp-controller="Perfil" asp-action="Index" style="color:var(--fc-proteina);">Ir a mi perfil →</a>
                            </div>
                        }
                    </div>
                    <div class="mb-3">
                        <label asp-for="NuevoEntrenamiento.DuracionMinutos" class="form-label"></label>
                        <input asp-for="NuevoEntrenamiento.DuracionMinutos" type="number" class="form-control" />
                        <span asp-validation-for="NuevoEntrenamiento.DuracionMinutos" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NuevoEntrenamiento.Notas" class="form-label"></label>
                        <textarea asp-for="NuevoEntrenamiento.Notas" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="NuevoEntrenamiento.Notas" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn fc-btn-primary w-100 py-2" disabled="@(!Model.PuedeRegistrarEntrenamiento)">
                        <i class="fas fa-check me-2" aria-hidden="true"></i>Marcar como hecho
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card shadow h-100">
            <div class="card-header py-3" style="border-left: 4px solid var(--fc-recuperar);">
                <h5 class="mb-0"><i class="fas fa-list-check me-2" style="color:var(--fc-recuperar);" aria-hidden="true"></i>Entrenamientos recientes</h5>
            </div>
            <div class="card-body">
                @if (!Model.TieneEntrenamientos)
                {
                    <div class="text-center py-5">
                        <i class="fas fa-dumbbell mb-3" style="font-size:2.5rem; color:var(--fc-border);" aria-hidden="true"></i>
                        <p class="text-muted mb-0">Todavía no marcaste ningún entrenamiento.</p>
                        <p class="text-muted small">Cada día que entrenes suma a tu racha.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle mb-0 fc-tabla-lista">
                            <thead>
                                <tr class="text-muted" style="font-size:0.75rem; text-transform:uppercase;">
                                    <th scope="col">Fecha</th>
                                    <th scope="col">Entrenamiento</th>
                                    <th scope="col">Duración</th>
                                    <th scope="col" class="text-end"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entrenamiento in Model.Entrenamientos.Take(10))
                                {
                                    <tr>
                                        <td class="small fc-lista-pie">@Model.EnLocal(entrenamiento.Fecha).ToString("dd/MM/yyyy")</td>
                                        <td class="fc-lista-desplegar">
                                            <strong class="fc-lista-titulo">@entrenamiento.NombreRutina</strong>
                                            @if (!string.IsNullOrWhiteSpace(entrenamiento.Notas))
                                            {
                                                <div class="small text-muted fc-lista-nota">@entrenamiento.Notas</div>
                                            }
                                        </td>
                                        <td class="small fc-lista-dato">@entrenamiento.DuracionMinutos min</td>
                                        <td class="text-end fc-lista-acciones">
                                            <form asp-controller="Progreso" asp-action="EliminarEntrenamiento" method="post"
                                                  class="d-inline m-0"
                                                  onsubmit="return confirm('¿Eliminar este entrenamiento? No se puede deshacer.');">
                                                <input type="hidden" name="id" value="@entrenamiento.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                                    <i class="fas fa-trash" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (Model.Entrenamientos.Count > 10)
                        {
                            <p class="text-muted small mb-0 mt-3">
                                Mostrando los 10 más recientes de @Model.Entrenamientos.Count.
                            </p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.TieneRecords)
{
    <div class="card shadow mt-4">
        <div class="card-header py-3" style="border-left: 4px solid var(--fc-recuperar);">
            <h5 class="mb-0"><i class="fas fa-trophy me-2" style="color:var(--fc-recuperar);" aria-hidden="true"></i>Récords personales</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0 fc-tabla-lista">
                    <thead>
                        <tr class="text-muted" style="font-size:0.75rem; text-transform:uppercase;">
                            <th scope="col">Ejercicio</th>
                            <th scope="col">Marca</th>
                            <th scope="col">Volumen</th>
                            <th scope="col">Logrado</th>
                            <th scope="col" class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in Model.Records)
                        {
                            <tr>
                                <td class="fc-lista-titulo"><strong>@record.EjercicioNombre</strong></td>
                                <td class="fc-lista-dato">
                                    <span style="color:var(--fc-recuperar);">@record.PesoKg kg</span>
                                    <span class="text-muted">× @record.Repeticiones</span>
                                </td>
                                <td class="small text-muted fc-lista-dato">@record.Volumen kg</td>
                                <td class="small fc-lista-pie">@Model.EnLocal(record.Fecha).ToString("dd/MM/yyyy")</td>
                                <td class="text-end fc-lista-acciones">
                                    <form asp-controller="Progreso" asp-action="EliminarRecord" method="post"
                                          class="d-inline m-0"
                                          onsubmit="return confirm('¿Eliminar este récord? No se puede deshacer.');">
                                        <input type="hidden" name="id" value="@record.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                            <i class="fas fa-trash" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="text-muted small mb-0 mt-3">
                Las marcas se registran desde <a asp-controller="Rutinas" asp-action="Index" style="color:var(--fc-proteina);">tu rutina</a>,
                en el detalle de cada ejercicio.
            </p>
        </div>
    </div>
}

@if (Model.PuedeGraficar)
{
    <div class="card shadow mt-4">
        <div class="card-header py-3" style="border-left: 4px solid var(--fc-logro);">
            <h5 class="mb-0"><i class="fas fa-chart-area me-2" style="color:var(--fc-logro);" aria-hidden="true"></i>Evolución del peso</h5>
        </div>
        <div class="card-body">
            <canvas id="grafica-peso" height="90"
                    @* Comillas simples a propósito: el JSON lleva comillas dobles y con
                       delimitador doble el atributo se cortaría en la primera. *@
                    data-etiquetas='@Json.Serialize(Model.EtiquetasGrafica)'
                    data-pesos='@Json.Serialize(Model.PesosGrafica)'></canvas>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (Model.PuedeGraficar)
    {
        <script src="~/lib/chart.js/dist/chart.umd.min.js"></script>
        <script>
            (function () {
                const canvas = document.getElementById('grafica-peso');
                const etiquetas = JSON.parse(canvas.dataset.etiquetas);
                const pesos = JSON.parse(canvas.dataset.pesos);

                // El canvas no entiende var(--...): Chart.js pinta pixeles, no CSS. Se
                // leen los tokens una vez y la grafica queda atada a la paleta igual
                // que el resto, sin repetir los hex a mano.
                const tema = getComputedStyle(document.documentElement);
                const token = nombre => tema.getPropertyValue(nombre).trim();

                const verde = token('--fc-logro');
                const grisTenue = token('--fc-border');
                const textoTenue = token('--fc-muted');

                new Chart(canvas, {
                    type: 'line',
                    data: {
                        labels: etiquetas,
                        datasets: [{
                            label: 'Peso (kg)',
                            data: pesos,
                            borderColor: verde,
                            backgroundColor: 'rgba(39, 209, 124, 0.12)',
                            pointBackgroundColor: verde,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            borderWidth: 2,
                            tension: 0.3,
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: contexto => `${contexto.parsed.y} kg`
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { color: grisTenue },
                                ticks: { color: textoTenue }
                            },
                            y: {
                                // Sin empezar en cero: la variación de peso se ve en pocos kilos
                                // y un eje desde 0 la aplastaría hasta hacerla ilegible.
                                beginAtZero: false,
                                grid: { color: grisTenue },
                                ticks: {
                                    color: textoTenue,
                                    callback: valor => valor + ' kg'
                                }
                            }
                        }
                    }
                });
            })();
        </script>
    }
}
