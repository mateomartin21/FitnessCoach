@model FitnessCoach.Models.AjustesViewModel
@using FitnessCoach.Application.Services
@using FitnessCoach.Domain.Catalogos
@{
    ViewData["Title"] = "Ajustes";
}

<div class="fc-ajustes-cabecera mb-4">
    <span class="fc-tag">Configuración</span>
    <h1 class="fc-ajustes-titulo">Ajustes</h1>
    <p class="text-muted mb-0">Lo que se configura una vez y manda en toda la app.</p>
</div>

@if (TempData["AjustesOk"] is string ok)
{
    <div class="alert fc-alerta-ok d-flex align-items-center gap-2 mb-4" role="status">
        <i class="fas fa-circle-check" aria-hidden="true"></i><span class="small">@ok</span>
    </div>
}
@if (TempData["AjustesError"] is string error)
{
    <div class="alert fc-alerta-error d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="fas fa-circle-exclamation" aria-hidden="true"></i><span class="small">@error</span>
    </div>
}

<div class="row g-4">
    <div class="col-12">
        <section class="fc-ajuste-bloque">
            <div class="fc-ajuste-cabeza">
                <i class="fas fa-dumbbell" aria-hidden="true"></i>
                <h2 class="fc-ajuste-titulo">Con qué entrenas</h2>
            </div>
            <p class="text-muted small">
                El catálogo tiene 1323 ejercicios. Marca lo que tienes a mano y tu rutina
                solo usará ejercicios que de verdad puedas hacer. Si no marcas nada, entra todo.
            </p>
            <form asp-action="GuardarEquipo" method="post">
                <fieldset class="border-0 p-0 m-0 mb-3">
                    <legend class="visually-hidden">Equipo disponible</legend>
                    <div class="fc-equipo-rejilla">
                        @foreach (var grupo in EquipoEntrenamiento.Disponibles)
                        {
                            var marcado = Model.EquipoDisponible.Contains(grupo.Valor, StringComparer.OrdinalIgnoreCase);
                            <label class="fc-equipo-opcion @(marcado ? "fc-equipo-activa" : "")">
                                <input type="checkbox" name="equipo" value="@grupo.Valor" class="form-check-input mt-0"
                                       checked="@marcado" />
                                <span>
                                    <span class="fc-equipo-titulo">@grupo.Titulo</span>
                                    <span class="fc-equipo-detalle">@grupo.Detalle</span>
                                </span>
                            </label>
                        }
                    </div>
                </fieldset>
                <div>
                    <button type="submit" class="btn fc-btn-primary px-3 py-2">
                        <i class="fas fa-save me-2" aria-hidden="true"></i>Guardar equipo
                    </button>
                </div>
            </form>
        </section>
    </div>

    <div class="col-12 col-lg-6">
        <section class="fc-ajuste-bloque h-100">
            <div class="fc-ajuste-cabeza">
                <i class="fas fa-user-shield" aria-hidden="true"></i>
                <h2 class="fc-ajuste-titulo">Tu cuenta</h2>
            </div>
            <dl class="fc-ajuste-dato">
                <dt>Correo</dt>
                <dd>@Model.Correo</dd>
            </dl>
            <p class="text-muted small">El correo identifica tu cuenta y no se puede cambiar.</p>
            <div class="fc-ajuste-acciones">
                <a asp-action="CambiarContrasena" class="btn fc-btn-outline px-3 py-2">
                    <i class="fas fa-key me-2" aria-hidden="true"></i>Cambiar contraseña
                </a>
            </div>
        </section>
    </div>

    <div class="col-12 col-lg-6">
        <section class="fc-ajuste-bloque h-100">
            <div class="fc-ajuste-cabeza">
                <i class="fas fa-clock" aria-hidden="true"></i>
                <h2 class="fc-ajuste-titulo">Tu calendario</h2>
            </div>
            <p class="text-muted small">
                Tu racha y el día del diario se cuentan con tu medianoche, no con la del servidor.
            </p>
            <form asp-action="GuardarZonaHoraria" method="post" class="fc-ajuste-acciones">
                <label for="selectZonaHoraria" class="form-label">Zona horaria</label>
                <select name="zonaHoraria" id="selectZonaHoraria" class="form-select mb-3"
                        data-sin-zona="@(string.IsNullOrWhiteSpace(Model.ZonaHoraria) ? "true" : "false")">
                    @foreach (var zona in ZonaHorariaUsuario.Comunes)
                    {
                        <option value="@zona.Id" selected="@(zona.Id == Model.ZonaHoraria)">@zona.Etiqueta</option>
                    }
                </select>
                <button type="submit" class="btn fc-btn-primary px-3 py-2">
                    <i class="fas fa-save me-2" aria-hidden="true"></i>Guardar zona
                </button>
            </form>
        </section>
    </div>

    <div class="col-12 col-lg-6">
        <section class="fc-ajuste-bloque h-100">
            <div class="fc-ajuste-cabeza">
                <i class="fas fa-utensils" aria-hidden="true"></i>
                <h2 class="fc-ajuste-titulo">Alimentación</h2>
            </div>
            <p class="text-muted small">
                Filtran el catálogo antes de armar tu plan: lo que excluyes no aparece ni como sustituto.
            </p>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <span class="fc-chip">@Model.DietasSeguidas @(Model.DietasSeguidas == 1 ? "dieta" : "dietas")</span>
                <span class="fc-chip">@Model.AlimentosExcluidos @(Model.AlimentosExcluidos == 1 ? "alimento excluido" : "alimentos excluidos")</span>
            </div>
            <div class="fc-ajuste-acciones">
                <a asp-controller="Alimentacion" asp-action="Preferencias" class="btn fc-btn-outline px-3 py-2">
                    <i class="fas fa-sliders me-2" aria-hidden="true"></i>Editar preferencias
                </a>
            </div>
        </section>
    </div>

    <div class="col-12 col-lg-6">
        <section class="fc-ajuste-bloque h-100">
            <div class="fc-ajuste-cabeza">
                <i class="fas fa-id-card" aria-hidden="true"></i>
                <h2 class="fc-ajuste-titulo">Tus datos</h2>
            </div>
            <p class="text-muted small">
                Edad, peso, estatura y objetivo viven en tu perfil: de ahí salen tus calorías,
                tu rutina y tu plan.
            </p>
            <div class="fc-ajuste-acciones d-flex flex-wrap gap-2">
                <a asp-controller="Perfil" asp-action="Index" class="btn fc-btn-outline px-3 py-2">
                    <i class="fas fa-user-edit me-2" aria-hidden="true"></i>Editar perfil
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                    <button type="submit" class="btn fc-btn-outline px-3 py-2">
                        <i class="fas fa-right-from-bracket me-2" aria-hidden="true"></i>Cerrar sesión
                    </button>
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        // El navegador ya sabe la zona del usuario. Si no está entre las comunes se agrega
        // como opción, y solo se preselecciona si el perfil no tiene una guardada (D-25).
        (function () {
            var select = document.getElementById('selectZonaHoraria');
            if (!select || !window.Intl) return;

            var detectada = Intl.DateTimeFormat().resolvedOptions().timeZone;
            if (!detectada) return;

            var existe = Array.prototype.some.call(select.options, function (o) { return o.value === detectada; });
            if (!existe) {
                var opcion = new Option(detectada + ' (detectada)', detectada);
                select.add(opcion, select.options[0]);
            }

            if (select.dataset.sinZona === 'true') select.value = detectada;
        })();
    </script>
}
