<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FitnessCoach</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md fc-navbar">
            <div class="container">
                <a class="navbar-brand fc-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/images/branding/logo.png" alt="FitnessCoach Logo" class="fc-navbar-logo me-2" />
                    <span class="fc-brand-text">FitnessCoach</span>
                </a>
                <button class="navbar-toggler fc-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <i class="fas fa-bars" style="color:#ff6b35;"></i>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav ms-auto align-items-center gap-1">
                        <li class="nav-item">
                            <a class="nav-link fc-nav-link" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-house me-1"></i>Inicio
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fc-nav-link" asp-controller="Perfil" asp-action="Index">
                                <i class="fas fa-user-circle me-1"></i>Mi Perfil
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fc-nav-link" asp-controller="Alimentacion" asp-action="Index">
                                <i class="fas fa-utensils me-1"></i>Mi Dieta
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fc-nav-link fc-nav-highlight" asp-controller="Rutinas" asp-action="Index">
                                <i class="fas fa-fire me-1"></i>Mi Rutina
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="IaCoach" asp-action="Index" style="color:#ff6b35; font-weight:700;">
                                <i class="fas fa-robot me-1"></i>IA Coach
                            </a>
                        </li>
                                                @if (User.Identity is not null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item d-flex align-items-center">
                                <span class="nav-link fc-nav-link"><i class="fas fa-user me-1"></i>@User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                                    <button type="submit" class="nav-link fc-nav-link btn btn-link" style="border:none; box-shadow:none;">
                                        <i class="fas fa-right-from-bracket me-1"></i>Salir
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link fc-nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="fas fa-right-to-bracket me-1"></i>Entrar
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fc-nav-link" asp-controller="Account" asp-action="Register">
                                    <i class="fas fa-user-plus me-1"></i>Registro
                                </a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="fc-footer mt-5">
        <div class="container">
            <div class="row align-items-center py-4">
                <div class="col-md-4 text-center text-md-start mb-3 mb-md-0">
                    <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-2 mb-1">
                        <img src="~/images/branding/logo.png" alt="FitnessCoach" class="fc-footer-logo" />
                        <span class="fw-bold fs-5" style="color:#ff6b35;">FitnessCoach</span>
                    </div>
                    <small class="text-muted">Tu entrenador personal inteligente</small>
                </div>
                <div class="col-md-4 text-center mb-3 mb-md-0">
                    <div class="d-flex justify-content-center gap-4">
                        <div>
                            <a asp-controller="Rutinas" asp-action="Index" class="fc-footer-link">Mi Rutina</a>
                        </div>
                        <div>
                            <a asp-controller="Alimentacion" asp-action="Index" class="fc-footer-link">Mi Dieta</a>
                        </div>
                        <div>
                            <a asp-controller="IaCoach" asp-action="Index" class="fc-footer-link">IA Coach</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-center text-md-end">
                    <small class="text-muted d-block">&copy; 2026 FitnessCoach</small>
                    <small class="text-muted">Tecnologico de Software &bull; Dr. Pedrozo</small>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
