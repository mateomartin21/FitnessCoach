<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FitnessCoach</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
</head>
<body>
    @{
        var ctrlActual = ViewContext.RouteData.Values["controller"]?.ToString();
        Func<string, string> activo = c => ctrlActual == c ? "active" : "";
        var estaLogueado = User.Identity is not null && User.Identity.IsAuthenticated;
    }
    <header>
        <nav class="navbar navbar-expand-lg fc-navbar">
            <div class="container">
                <a class="navbar-brand fc-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/images/branding/logo.png" alt="FitnessCoach" class="fc-navbar-logo me-2" />
                    <span class="fc-brand-text">FitnessCoach</span>
                </a>
                <button class="navbar-toggler fc-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <i class="fas fa-bars" style="color:var(--fc-primary);"></i>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav me-auto align-items-lg-center gap-1">
                        <li class="nav-item"><a class="nav-link fc-nav-link @activo("Home")" asp-controller="Home" asp-action="Index"><i class="fas fa-house me-1"></i>Inicio</a></li>
                        <li class="nav-item"><a class="nav-link fc-nav-link @activo("Perfil")" asp-controller="Perfil" asp-action="Index"><i class="fas fa-user-circle me-1"></i>Perfil</a></li>
                        <li class="nav-item"><a class="nav-link fc-nav-link @activo("Alimentacion")" asp-controller="Alimentacion" asp-action="Index"><i class="fas fa-utensils me-1"></i>Dieta</a></li>
                        <li class="nav-item"><a class="nav-link fc-nav-link @activo("Diario")" asp-controller="Diario" asp-action="Index"><i class="fas fa-book-open me-1"></i>Diario</a></li>
                        <li class="nav-item"><a class="nav-link fc-nav-link @activo("Rutinas")" asp-controller="Rutinas" asp-action="Index"><i class="fas fa-fire me-1"></i>Rutina</a></li>
                        <li class="nav-item"><a class="nav-link fc-nav-link @activo("Progreso")" asp-controller="Progreso" asp-action="Index"><i class="fas fa-chart-line me-1"></i>Progreso</a></li>
                        <li class="nav-item"><a class="nav-link fc-nav-link @activo("Gamificacion")" asp-controller="Gamificacion" asp-action="Index"><i class="fas fa-trophy me-1"></i>Logros</a></li>
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                        <li class="nav-item my-1 my-lg-0">
                            <a class="fc-nav-cta" asp-controller="IaCoach" asp-action="Index"><i class="fas fa-robot"></i>Koda IA</a>
                        </li>
                        @if (estaLogueado)
                        {
                            <li class="nav-item d-none d-lg-flex"><span class="fc-nav-sep"></span></li>
                            <li class="nav-item"><span class="fc-user-chip"><i class="fas fa-user"></i>@User.Identity!.Name</span></li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                                    <button type="submit" class="nav-link fc-logout"><i class="fas fa-right-from-bracket me-1"></i>Salir</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link fc-nav-link @activo("Account")" asp-controller="Account" asp-action="Login"><i class="fas fa-right-to-bracket me-1"></i>Entrar</a></li>
                            <li class="nav-item"><a class="nav-link fc-nav-link" asp-controller="Account" asp-action="Register"><i class="fas fa-user-plus me-1"></i>Registro</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="fc-footer mt-5">
        <div class="container">
            <div class="row gy-4 py-5">
                <div class="col-lg-4">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <img src="~/images/branding/logo.png" alt="FitnessCoach" class="fc-footer-logo" />
                        <span class="fw-bold fs-5" style="color:var(--fc-primary);">FitnessCoach</span>
                    </div>
                    <p class="text-muted mb-0" style="max-width:290px; font-size:.85rem;">
                        Tu entrenador personal inteligente. Rutinas, nutrición y un coach —Koda— que te acompaña día a día.
                    </p>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="fc-foot-head">Navegación</div>
                    <div class="d-flex flex-column gap-2">
                        <a asp-controller="Rutinas" asp-action="Index" class="fc-footer-link">Mi Rutina</a>
                        <a asp-controller="Alimentacion" asp-action="Index" class="fc-footer-link">Mi Dieta</a>
                        <a asp-controller="Progreso" asp-action="Index" class="fc-footer-link">Mi Progreso</a>
                        <a asp-controller="Gamificacion" asp-action="Index" class="fc-footer-link">Logros</a>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="fc-foot-head">Koda &amp; más</div>
                    <div class="d-flex flex-column gap-2">
                        <a asp-controller="IaCoach" asp-action="Index" class="fc-footer-link">Koda IA</a>
                        <a asp-controller="Home" asp-action="Privacy" class="fc-footer-link">Privacidad</a>
                    </div>
                </div>
                <div class="col-lg-2">
                    <div class="fc-foot-head">Proyecto</div>
                    <p class="text-muted mb-0" style="font-size:.8rem;">Trabajo académico<br />Tecnológico de Software<br />Dr. Pedrozo</p>
                </div>
            </div>
            <div class="fc-foot-bottom d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                <span>&copy; 2026 FitnessCoach · Proyecto académico</span>
                <a asp-controller="Home" asp-action="Privacy" class="fc-footer-link">Política de Privacidad</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
