<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FitnessCoach</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/fontawesome-subset.css" asp-append-version="true" />
</head>
<body>
    @{
        var ctrlActual = ViewContext.RouteData.Values["controller"]?.ToString();
        Func<string, string> activo = c => ctrlActual == c ? "active" : "";
        var estaLogueado = User.Identity is not null && User.Identity.IsAuthenticated;
        var nombreCuenta = User.Identity?.Name ?? string.Empty;
        // Substring(0,1) sobre una cadena vacia lanza; la inicial es decorativa.
        var inicialCuenta = nombreCuenta.Length > 0 ? char.ToUpperInvariant(nombreCuenta[0]).ToString() : "?";
    }
    <a class="fc-salto-contenido" href="#contenido">Saltar al contenido</a>

    <header>
        <nav class="navbar navbar-expand-lg fc-navbar">
            <div class="container">
                <a class="navbar-brand fc-brand" asp-controller="Home" asp-action="Index">
                    <span class="fc-brand-text">FitnessCoach</span>
                </a>
                <button class="navbar-toggler fc-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbar-principal" aria-expanded="false" aria-label="Abrir o cerrar el menú">
                    <i class="fas fa-bars" style="color:var(--fc-primary-texto);" aria-hidden="true"></i>
                </button>
                <div class="navbar-collapse collapse" id="navbar-principal">
                    <ul class="navbar-nav me-auto align-items-lg-center gap-1">
                        <li class="nav-item"><a class="nav-link fc-nav-link @activo("Home")" asp-controller="Home" asp-action="Index"><i class="fas fa-house me-1" aria-hidden="true"></i>Inicio</a></li>
                        <li class="nav-item"><a class="nav-link fc-nav-link @activo("Perfil")" asp-controller="Perfil" asp-action="Index"><i class="fas fa-user-circle me-1" aria-hidden="true"></i>Perfil</a></li>
                        <li class="nav-item"><a class="nav-link fc-nav-link @activo("Alimentacion")" asp-controller="Alimentacion" asp-action="Index"><i class="fas fa-utensils me-1" aria-hidden="true"></i>Dieta</a></li>
                        <li class="nav-item"><a class="nav-link fc-nav-link @activo("Diario")" asp-controller="Diario" asp-action="Index"><i class="fas fa-book-open me-1" aria-hidden="true"></i>Diario</a></li>
                        <li class="nav-item"><a class="nav-link fc-nav-link @activo("Rutinas")" asp-controller="Rutinas" asp-action="Index"><i class="fas fa-fire me-1" aria-hidden="true"></i>Rutina</a></li>
                        <li class="nav-item"><a class="nav-link fc-nav-link @activo("Progreso")" asp-controller="Progreso" asp-action="Index"><i class="fas fa-chart-line me-1" aria-hidden="true"></i>Progreso</a></li>
                        <li class="nav-item"><a class="nav-link fc-nav-link @activo("Gamificacion")" asp-controller="Gamificacion" asp-action="Index"><i class="fas fa-trophy me-1" aria-hidden="true"></i>Logros</a></li>
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                        <li class="nav-item my-1 my-lg-0">
                            <a class="fc-nav-cta" asp-controller="IaCoach" asp-action="Index"><img src="~/images/koda/koda-logo.png" alt="" class="fc-nav-cta-koda" />Koda IA</a>
                        </li>
                        @if (estaLogueado)
                        {
                            @* Cuenta, ajustes y salida detrás del avatar: sueltos en la barra
                               no entraban a 1280px y aparecía scroll horizontal. *@
                            <li class="nav-item dropdown">
                                <a class="fc-cuenta-btn dropdown-toggle" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false" title="@nombreCuenta">
                                    <span class="fc-cuenta-avatar" aria-hidden="true">@inicialCuenta</span>
                                    <span class="fc-cuenta-nombre">@nombreCuenta</span>
                                    <i class="fas fa-chevron-down" style="font-size:.7rem;" aria-hidden="true"></i>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end fc-menu-cuenta">
                                    <li><div class="fc-menu-correo">@nombreCuenta</div></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Perfil" asp-action="Index">
                                            <i class="fas fa-user-circle" aria-hidden="true"></i>Mi perfil
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Ajustes" asp-action="Index">
                                            <i class="fas fa-gear" aria-hidden="true"></i>Ajustes
                                        </a>
                                    </li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                            <button type="submit" class="dropdown-item fc-menu-salir">
                                                <i class="fas fa-right-from-bracket" aria-hidden="true"></i>Cerrar sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link fc-nav-link @activo("Account")" asp-controller="Account" asp-action="Login"><i class="fas fa-right-to-bracket me-1" aria-hidden="true"></i>Entrar</a></li>
                            <li class="nav-item"><a class="nav-link fc-nav-link" asp-controller="Account" asp-action="Register"><i class="fas fa-user-plus me-1" aria-hidden="true"></i>Registro</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" id="contenido" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="fc-footer mt-5">
        <div class="container">
            <div class="row gy-4 py-5">
                <div class="col-lg-5">
                    <span class="fw-bold fs-4" style="color:var(--fc-primary-texto);">FitnessCoach</span>
                    <p class="text-muted mb-0 mt-2" style="max-width:340px; font-size:.9rem;">
                        Tu entrenador personal inteligente. Rutinas, nutrición y un coach —Koda— que te guía,
                        te analiza y te acompaña día a día.
                    </p>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="fc-foot-head">Navegación</div>
                    <div class="d-flex flex-column gap-2">
                        <a asp-controller="Rutinas" asp-action="Index" class="fc-footer-link">Mi Rutina</a>
                        <a asp-controller="Alimentacion" asp-action="Index" class="fc-footer-link">Mi Dieta</a>
                        <a asp-controller="Progreso" asp-action="Index" class="fc-footer-link">Mi Progreso</a>
                        <a asp-controller="Gamificacion" asp-action="Index" class="fc-footer-link">Logros</a>
                    </div>
                </div>
                <div class="col-6 col-lg-4">
                    <div class="fc-foot-head">Recursos</div>
                    <div class="d-flex flex-column gap-2">
                        <a asp-controller="IaCoach" asp-action="Index" class="fc-footer-link">Koda IA</a>
                        @if (estaLogueado)
                        {
                            <a asp-controller="Ajustes" asp-action="Index" class="fc-footer-link">Ajustes</a>
                        }
                        <a asp-controller="Home" asp-action="Privacy" class="fc-footer-link">Política de Privacidad</a>
                    </div>
                </div>
            </div>
            <div class="fc-foot-bottom d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                <span>&copy; 2026 FitnessCoach. Todos los derechos reservados.</span>
                <a asp-controller="Home" asp-action="Privacy" class="fc-footer-link">Privacidad</a>
            </div>
        </div>
    </footer>

    @* ---- Navegación de móvil ----
       Cuatro destinos al alcance del pulgar y Koda al centro. El resto vive en la
       hoja "Más": siete pestañas abajo no se pueden tocar sin errar. *@
    <nav class="fc-tabbar" aria-label="Navegación principal">
        <a class="fc-tab @activo("Home")" asp-controller="Home" asp-action="Index">
            <i class="fas fa-house" aria-hidden="true"></i><span>Inicio</span>
        </a>
        <a class="fc-tab @activo("Rutinas")" asp-controller="Rutinas" asp-action="Index">
            <i class="fas fa-fire" aria-hidden="true"></i><span>Rutina</span>
        </a>
        <a class="fc-tab fc-tab-koda @activo("IaCoach")" asp-controller="IaCoach" asp-action="Index">
            <span class="fc-tab-burbuja"><img src="~/images/koda/koda-logo.png" alt="" /></span>
            <span>Koda</span>
        </a>
        <a class="fc-tab @activo("Alimentacion")" asp-controller="Alimentacion" asp-action="Index">
            <i class="fas fa-utensils" aria-hidden="true"></i><span>Dieta</span>
        </a>
        <button class="fc-tab" type="button" data-bs-toggle="offcanvas" data-bs-target="#hoja-mas"
                aria-controls="hoja-mas">
            <i class="fas fa-bars" aria-hidden="true"></i><span>Más</span>
        </button>
    </nav>

    <div class="offcanvas offcanvas-bottom fc-hoja" tabindex="-1" id="hoja-mas" aria-labelledby="hoja-mas-titulo">
        <div class="fc-hoja-agarre" aria-hidden="true"></div>
        <h2 id="hoja-mas-titulo" class="visually-hidden">Más secciones</h2>
        <div class="fc-hoja-rejilla">
            <a class="fc-hoja-item @activo("Progreso")" asp-controller="Progreso" asp-action="Index">
                <i class="fas fa-chart-line" aria-hidden="true"></i>Progreso
            </a>
            <a class="fc-hoja-item @activo("Diario")" asp-controller="Diario" asp-action="Index">
                <i class="fas fa-book-open" aria-hidden="true"></i>Diario
            </a>
            <a class="fc-hoja-item @activo("Gamificacion")" asp-controller="Gamificacion" asp-action="Index">
                <i class="fas fa-trophy" aria-hidden="true"></i>Logros
            </a>
            <a class="fc-hoja-item @activo("Perfil")" asp-controller="Perfil" asp-action="Index">
                <i class="fas fa-user-circle" aria-hidden="true"></i>Perfil
            </a>
            @if (estaLogueado)
            {
                <a class="fc-hoja-item @activo("Ajustes")" asp-controller="Ajustes" asp-action="Index">
                    <i class="fas fa-gear" aria-hidden="true"></i>Ajustes
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="fc-hoja-item fc-hoja-salir">
                        <i class="fas fa-right-from-bracket" aria-hidden="true"></i>Salir
                    </button>
                </form>
            }
            else
            {
                <a class="fc-hoja-item" asp-controller="Account" asp-action="Login">
                    <i class="fas fa-right-to-bracket" aria-hidden="true"></i>Entrar
                </a>
                <a class="fc-hoja-item" asp-controller="Account" asp-action="Register">
                    <i class="fas fa-user-plus" aria-hidden="true"></i>Registro
                </a>
            }
        </div>
        @if (estaLogueado)
        {
            <div class="fc-hoja-cuenta">
                <img src="~/images/koda/koda-logo.png" alt="" />
                <span>@nombreCuenta</span>
            </div>
        }
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/koda.js" asp-append-version="true"></script>
    <script src="~/js/navegacion.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
