@*
    Tarjeta reutilizable del Lobo analizando un aspecto del usuario con sus datos
    reales. El modelo es el aspecto: "progreso", "dieta", "rutina" o "semana".
    El endpoint /IaCoach/Analizar ya resuelve cada uno contra el contexto rico.

    La respuesta se pinta con Koda.pintar, que escapa el texto de la IA antes de
    aplicarle su markdown minimo (parrafos y negritas): nada de lo que llegue del
    modelo puede inyectar HTML. Los ids llevan el aspecto como sufijo para que dos
    tarjetas en la misma pantalla no choquen.
*@
@model string
@{
    var aspecto = string.IsNullOrWhiteSpace(Model) ? "progreso" : Model.ToLowerInvariant();
    // La invitacion dice QUE se lleva el usuario, no que apriete el boton: el boton
    // ya dice lo que hace y repetirlo era una linea de texto que nadie leia.
    var (titulo, invitacion, cargando) = aspecto switch
    {
        "dieta" => (
            "Koda revisa tu dieta",
            "Qué vienes comiendo bien y el ajuste que más te conviene hoy.",
            "Koda está revisando tu plan..."),
        "rutina" => (
            "Koda revisa tu rutina",
            "Si tu rutina apunta a tu objetivo, y cómo sacarle más.",
            "Koda está revisando tu rutina..."),
        "semana" => (
            "El resumen de tu semana",
            "Tus entrenamientos, tu racha y tu peso, contados por Koda.",
            "Koda está repasando tu semana..."),
        _ => (
            "Koda analiza tu progreso",
            "Tus números, tus récords y el ajuste que más importa ahora.",
            "Koda está revisando tus números..."),
    };
    var botonId = $"btnAnalizar-{aspecto}";
    var salidaId = $"analisis-{aspecto}";
}

@* En el telefono el titulo y el boton no entran en el mismo renglon: el titulo se
   partia en dos y quedaba por debajo del boton. Se apilan y el boton va a lo ancho. *@
<div class="fc-feature-card fc-analisis mb-4">
    <div class="fc-analisis-cabeza">
        <h5 class="fc-analisis-titulo">
            <img src="/images/koda/koda-enfocado.png" alt="Koda" width="32" height="32" class="koda-glow-still" style="object-fit:contain; image-rendering:pixelated;" />
            @titulo
        </h5>
        <button id="@botonId" class="btn fc-btn-primary btn-sm" data-aspecto="@aspecto" data-cargando="@cargando">
            <i class="fas fa-wand-magic-sparkles me-1" aria-hidden="true"></i>Pedir análisis
        </button>
    </div>
    @* aria-live: el analisis llega por fetch y sin esto un lector de pantalla no lo anuncia. *@
    <div id="@salidaId" class="fc-respuesta fc-respuesta-tenue" role="status" aria-live="polite">
        <p>@invitacion</p>
    </div>
</div>
@Html.AntiForgeryToken()

<script>
    (function () {
        const boton = document.getElementById('@botonId');
        const salida = document.getElementById('@salidaId');
        if (!boton || !salida) return;

        // Un texto suelto mientras carga y HTML formateado cuando llega la respuesta.
        const pintar = texto => window.Koda ? Koda.pintar(salida, texto) : (salida.textContent = texto);

        boton.addEventListener('click', async () => {
            boton.disabled = true;
            pintar(boton.dataset.cargando);
            salida.classList.add('fc-respuesta-tenue');
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const res = await fetch('/IaCoach/Analizar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify({ aspecto: boton.dataset.aspecto })
                });
                const data = await res.json();
                salida.classList.remove('fc-respuesta-tenue');
                pintar(data.respuesta);
            } catch {
                pintar('No pude traer el análisis ahora, campeón. Prueba de nuevo en un momento.');
            } finally {
                boton.disabled = false;
            }
        });
    })();
</script>
